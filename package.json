{
  "name": "thrj-main",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "pages:dev": "wrangler pages dev --port 5173 --proxy 4173 -- react-router dev --port 4173 --strictPort",
    "build": "react-router build",
    "preview": "react-router-serve ./build/server/index.js",
    "deploy": "wrangler pages deploy ./build/client --project-name thrjtech-main",
    "publish": "npm run build && npm run deploy",
    "translate": "node translate-and-merge.js",
    "translate:fast": "node translate-and-merge-fast.js",
    "verify-translations": "node verify-translations.js"
  },
  "dependencies": {
    "@react-router/cloudflare": "^7.14.2",
    "@react-router/dev": "^7.14.2",
    "gifenc": "^1.0.3",
    "heic2any": "^0.0.4",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.5",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-i18next": "^17.0.4",
    "react-router": "^7.14.2",
    "react-router-dom": "^7.14.2",
    "utif": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^7.3.1",
    "wrangler": "^4.76.0"
  }
}
